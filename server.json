{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.kayhendriksen/foehn",
  "title": "foehn",
  "description": "Access Swiss meteorological open data from MeteoSwiss, powered by foehn",
  "version": "0.5.0",
  "websiteUrl": "https://github.com/kayhendriksen/foehn",
  "repository": {
    "url": "https://github.com/kayhendriksen/foehn",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "foehn",
      "version": "0.5.0",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "runtimeArguments": [
        {
          "type": "named",
          "name": "--with",
          "value": "foehn[mcp]==0.5.0",
          "description": "Install the optional MCP server dependencies alongside foehn"
        }
      ],
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
